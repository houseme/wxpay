# WeChat Pay application info
WXPAY_APP_ID=wx88888888
WXPAY_MERCHANT_ID=1900000109

# API v3 security config
WXPAY_API_V3_KEY=replace-with-your-32-byte-api-key
WXPAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WXPAY_CERT_SERIAL_NUMBER=replace-with-merchant-certificate-serial

# Required platform trust: configure the public key pair below, or the certificate path.
# Obtain this material through the merchant platform's trusted channel.
# These are platform verification keys, not the merchant private key or certificate.
WXPAY_PLATFORM_PUBLIC_KEY_ID=
WXPAY_PLATFORM_PUBLIC_KEY_PATH=
WXPAY_PLATFORM_CERT_PATH=

# Webhook server bind address
WXPAY_WEBHOOK_BIND=0.0.0.0:8080
